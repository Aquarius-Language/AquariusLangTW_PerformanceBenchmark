<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants Condition="'$(Legacy)' == 'true'">$(DefineConstants);LEGACY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Legacy)' != 'true'">
    <Reference Include="AquariusCore"><HintPath>$(AquariusRelease)/AquariusCore.dll</HintPath></Reference>
    <Reference Include="AquariusDesktop"><HintPath>$(AquariusRelease)/AquariusDesktop.dll</HintPath></Reference>
    <Reference Include="Wasmtime.Dotnet"><HintPath>$(AquariusRelease)/Wasmtime.Dotnet.dll</HintPath></Reference>
    <Content Include="$(AquariusRelease)/wasmtime.dll" Link="wasmtime.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(Legacy)' == 'true'">
    <Reference Include="AquariusLangVM"><HintPath>$(AquariusRelease)/AquariusLangVM.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Text.Json"><HintPath>$(AquariusRelease)/System.Text.Json.dll</HintPath></Reference>
    <Reference Include="System.Text.Encodings.Web"><HintPath>$(AquariusRelease)/System.Text.Encodings.Web.dll</HintPath></Reference>
  </ItemGroup>
</Project>
