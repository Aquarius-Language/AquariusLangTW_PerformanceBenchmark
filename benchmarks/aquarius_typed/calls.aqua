const benchmark_n: int = 1000;
var benchmark_warmups: int = 0;
var benchmark_timed_runs: int = 1;
# Calls a small two-argument function n times.
var mix = function(a: int, b: int): int { return (a * 31 + b) % 1000003; };
var benchmark_run = function(): int {
    var acc: int = 0;
    for (var i: int = 0; i < benchmark_n; i++) { acc = mix(acc, i); }
    return acc;
};
# Untimed in-process warm-up runs, then timed runs; the harness substitutes both counts.
for (var benchmark_warmup = 0; benchmark_warmup < benchmark_warmups; benchmark_warmup++) { benchmark_run(); }
for (var benchmark_round = 0; benchmark_round < benchmark_timed_runs; benchmark_round++) {
    var benchmark_start = currentTime();
    var benchmark_result = benchmark_run();
    var benchmark_elapsed_ms = currentTime() - benchmark_start;
    print("RESULT", benchmark_result);
    print("ELAPSED_MS", benchmark_elapsed_ms);
}
