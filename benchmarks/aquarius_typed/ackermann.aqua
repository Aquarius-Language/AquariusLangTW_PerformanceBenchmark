變數 benchmark_n: 整數 = 6;
變數 benchmark_warmups: 整數 = 0;
變數 benchmark_timed_runs: 整數 = 1;
變數 ack = 函式(m: 整數, n: 整數): 整數 {
    如果 (m == 0) { 回傳 n + 1; }
    如果 (n == 0) { 回傳 ack(m - 1, 1); }
    回傳 ack(m - 1, ack(m, n - 1));
};
變數 benchmark_run = 函式(): 整數 {
    回傳 ack(3, benchmark_n);
};
# Untimed in-process warm-up runs, then timed runs; the harness substitutes both counts.
迴圈 (變數 benchmark_warmup: 整數 = 0; benchmark_warmup < benchmark_warmups; benchmark_warmup++) { benchmark_run(); }
迴圈 (變數 benchmark_round: 整數 = 0; benchmark_round < benchmark_timed_runs; benchmark_round++) {
    變數 benchmark_start = 目前時間();
    變數 benchmark_result = benchmark_run();
    變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
    印出("RESULT", benchmark_result);
    印出("ELAPSED_MS", benchmark_elapsed_ms);
}
