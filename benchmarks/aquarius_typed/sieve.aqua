變數 benchmark_n: 整數 = 10000;
變數 benchmark_start = 目前時間();
變數 flags: 布林[] = 陣列.建立(benchmark_n + 1, 真);
flags[0] = 假;
flags[1] = 假;
迴圈 (變數 p: 整數 = 2; p * p <= benchmark_n; p++) {
    如果 (flags[p]) {
        迴圈 (變數 j: 整數 = p * p; j <= benchmark_n; j += p) { flags[j] = 假; }
    }
}
變數 count: 整數 = 0;
迴圈 (變數 i: 整數 = 2; i <= benchmark_n; i++) { 如果 (flags[i]) { count += 1; } }
變數 benchmark_result = count;
變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
印出("RESULT", benchmark_result);
印出("ELAPSED_MS", benchmark_elapsed_ms);
