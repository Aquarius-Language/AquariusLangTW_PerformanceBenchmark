變數 benchmark_n: 整數 = 80;
變數 benchmark_run = 函式(): 整數 {
    變數 checksum: 整數 = 0;
    迴圈 (變數 y: 整數 = 0; y < benchmark_n; y++) {
        變數 ci: 雙精度 = 2.0d * y / benchmark_n - 1.0d;
        迴圈 (變數 x: 整數 = 0; x < benchmark_n; x++) {
            變數 cr: 雙精度 = 3.0d * x / benchmark_n - 2.0d;
            變數 zr: 雙精度 = 0.0d; 變數 zi: 雙精度 = 0.0d; 變數 count: 整數 = 0;
            迴圈 (變數 escape_guard: 整數 = 0; count < 60 && zr * zr + zi * zi <= 4.0d; count++) {
                變數 next_r: 雙精度 = zr * zr - zi * zi + cr;
                zi = 2.0d * zr * zi + ci; zr = next_r;
            }
            checksum += count;
        }
    }
    回傳 checksum;
};
# Untimed warm-up runs, identical in every language.
迴圈 (變數 benchmark_warmup: 整數 = 0; benchmark_warmup < 3; benchmark_warmup++) { benchmark_run(); }
變數 benchmark_start = 目前時間();
變數 benchmark_result = benchmark_run();
變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
印出("RESULT", benchmark_result);
印出("ELAPSED_MS", benchmark_elapsed_ms);
