變數 benchmark_n: 整數 = 10000;
變數 benchmark_run = 函式(): 整數 {
    變數 checksum: 整數 = 0;
    迴圈 (變數 start: 整數 = 1; start <= benchmark_n; start++) {
        迴圈 (變數 value: 整數 = start; value != 1; checksum++) {
            變數 half: 整數 = value / 2;
            如果 (half * 2 == value) { value = half; } 否則 { value = value * 3 + 1; }
        }
    }
    回傳 checksum;
};
# Untimed warm-up runs, identical in every language.
迴圈 (變數 benchmark_warmup: 整數 = 0; benchmark_warmup < 3; benchmark_warmup++) { benchmark_run(); }
變數 benchmark_start = 目前時間();
變數 benchmark_result = benchmark_run();
變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
印出("RESULT", benchmark_result);
印出("ELAPSED_MS", benchmark_elapsed_ms);
