變數 benchmark_n: 整數 = 2000;
變數 benchmark_warmups: 整數 = 0;
變數 benchmark_timed_runs: 整數 = 1;
# A typed function declares its result, so sort returns 0 after sorting in place.
變數 sort = 函式(a: 整數[], lo: 整數, hi: 整數): 整數 {
    變數 i: 整數 = lo; 變數 j: 整數 = hi;
    變數 pivot: 整數 = a[(lo + hi) / 2];
    # Aquarius requires a declaration and an update expression in every loop.
    迴圈 (變數 partition_guard: 整數 = 0; i <= j; 0) {
        迴圈 (變數 left_guard: 整數 = 0; a[i] < pivot; i++) { }
        迴圈 (變數 right_guard: 整數 = 0; a[j] > pivot; j -= 1) { }
        如果 (i <= j) {
            變數 tmp: 整數 = a[i]; a[i] = a[j]; a[j] = tmp; i++; j -= 1;
        }
    }
    如果 (lo < j) { sort(a, lo, j); }
    如果 (i < hi) { sort(a, i, hi); }
    回傳 0;
};
變數 benchmark_run = 函式(): 整數 {
    變數 values: 整數[] = 陣列.建立(0, 0, benchmark_n);
    變數 seed: 整數 = 42;
    迴圈 (變數 i: 整數 = 0; i < benchmark_n; i++) {
        變數 raw: 整數 = seed * 251 + 17;
        seed = raw - (raw / 65536) * 65536;
        陣列.追加(values, seed);
    }

    sort(values, 0, benchmark_n - 1);
    變數 checksum: 整數 = 0;
    變數 ordered: 布林 = 真;
    迴圈 (變數 i: 整數 = 0; i < benchmark_n; i++) {
        如果 (i > 0) { 如果 (values[i] < values[i - 1]) { ordered = 假; } }
        checksum += values[i] * (i + 1);
        checksum -= (checksum / 1000003) * 1000003;
    }
    如果 (ordered) { 回傳 checksum; }
    回傳 -1;
};
# Untimed in-process warm-up runs, then timed runs; the harness substitutes both counts.
迴圈 (變數 benchmark_warmup: 整數 = 0; benchmark_warmup < benchmark_warmups; benchmark_warmup++) { benchmark_run(); }
迴圈 (變數 benchmark_round: 整數 = 0; benchmark_round < benchmark_timed_runs; benchmark_round++) {
    變數 benchmark_start = 目前時間();
    變數 benchmark_result = benchmark_run();
    變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
    印出("RESULT", benchmark_result);
    印出("ELAPSED_MS", benchmark_elapsed_ms);
}
