變數 benchmark_n = 45;
變數 benchmark_start = 目前時間();
變數 a = []; 變數 b = [];
迴圈 (變數 i = 0; i < benchmark_n; i++) {
    迴圈 (變數 j = 0; j < benchmark_n; j++) {
        變數 x = i + j; 變數 y = i * 2 + j;
        a = 加入(a, x - (x / 7) * 7);
        b = 加入(b, y - (y / 5) * 5);
    }
}
變數 checksum = 0;
迴圈 (變數 i = 0; i < benchmark_n; i++) {
    迴圈 (變數 j = 0; j < benchmark_n; j++) {
        變數 total = 0;
        迴圈 (變數 k = 0; k < benchmark_n; k++) { total += a[i * benchmark_n + k] * b[k * benchmark_n + j]; }
        checksum += total;
    }
}
變數 benchmark_result = checksum;
變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
印出("RESULT", benchmark_result);
印出("ELAPSED_MS", benchmark_elapsed_ms);
