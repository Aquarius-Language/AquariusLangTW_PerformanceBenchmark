變數 benchmark_n = 10000;
變數 benchmark_warmups = 0;
變數 benchmark_timed_runs = 1;
變數 benchmark_run = 函式() {
    變數 flags = 陣列.建立(benchmark_n + 1, 真);
    flags[0] = 假;
    flags[1] = 假;
    迴圈 (變數 p = 2; p * p <= benchmark_n; p++) {
        如果 (flags[p]) {
            迴圈 (變數 j = p * p; j <= benchmark_n; j += p) { flags[j] = 假; }
        }
    }
    變數 count = 0;
    迴圈 (變數 i = 2; i <= benchmark_n; i++) { 如果 (flags[i]) { count += 1; } }
    回傳 count;
};
# Untimed in-process warm-up runs, then timed runs; the harness substitutes both counts.
迴圈 (變數 benchmark_warmup = 0; benchmark_warmup < benchmark_warmups; benchmark_warmup++) { benchmark_run(); }
迴圈 (變數 benchmark_round = 0; benchmark_round < benchmark_timed_runs; benchmark_round++) {
    變數 benchmark_start = 目前時間();
    變數 benchmark_result = benchmark_run();
    變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
    印出("RESULT", benchmark_result);
    印出("ELAPSED_MS", benchmark_elapsed_ms);
}
