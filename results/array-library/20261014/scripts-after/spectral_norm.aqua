變數 benchmark_n = 60;
變數 element = 函式(i, j) {
    變數 s = i + j;
    回傳 1.0d / (s * (s + 1) / 2 + i + 1);
};
變數 multiply = 函式(src, dst, transpose) {
    迴圈 (變數 i = 0; i < benchmark_n; i++) {
        變數 total = 0.0d;
        迴圈 (變數 j = 0; j < benchmark_n; j++) {
            變數 coefficient = 0.0d;
            如果 (transpose) { coefficient = element(j, i); } 否則 { coefficient = element(i, j); }
            total += coefficient * src[j];
        }
        dst[i] = total;
    }
};
變數 benchmark_start = 目前時間();
變數 u = 陣列.建立(benchmark_n, 1.0d);
變數 v = 陣列.建立(benchmark_n, 0.0d);
變數 temp = 陣列.建立(benchmark_n, 0.0d);
迴圈 (變數 iteration = 0; iteration < 10; iteration++) {
    multiply(u, temp, 假); multiply(temp, v, 真);
    multiply(v, temp, 假); multiply(temp, u, 真);
}
變數 uv = 0.0d; 變數 vv = 0.0d;
迴圈 (變數 i = 0; i < benchmark_n; i++) { uv += u[i] * v[i]; vv += v[i] * v[i]; }
變數 benchmark_result = uv / vv;
變數 benchmark_elapsed_ms = 目前時間() - benchmark_start;
印出("RESULT", benchmark_result);
印出("ELAPSED_MS", benchmark_elapsed_ms);
