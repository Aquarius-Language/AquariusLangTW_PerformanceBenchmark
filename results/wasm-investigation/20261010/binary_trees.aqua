變數 benchmark_n = 12;
變數 build = 函式(depth) {
    如果 (depth == 0) { 回傳 [0, 0]; }
    回傳 [build(depth - 1), build(depth - 1)];
};
變數 check = 函式(tree, depth) {
    如果 (depth == 0) { 回傳 1; }
    回傳 1 + check(tree[0], depth - 1) + check(tree[1], depth - 1);
};
變數 checksum = 0;
迴圈 (變數 i = 0; i < 8; i++) {
    變數 tree = build(benchmark_n);
    checksum += check(tree, benchmark_n);
}
印出("RESULT", checksum);
