    "quicksort/copy_append": {
      "benchmark": "quicksort",
      "variant": "copy_append",
      "source": "from time import perf_counter_ns\nbenchmark_n = 2000\ndef sort(a, lo, hi):\n    i, j = lo, hi\n    pivot = a[(lo + hi) // 2]\n    while i <= j:\n        while a[i] < pivot:\n            i += 1\n        while a[j] > pivot:\n            j -= 1\n        if i <= j:\n            tmp = a[i]\n            a[i] = a[j]\n            a[j] = tmp\n            i += 1\n            j -= 1\n    if lo < j:\n        sort(a, lo, j)\n    if i < hi:\n        sort(a, i, hi)\n\nbenchmark_start = perf_counter_ns()\nvalues = []\nseed = 42\nfor i in range(benchmark_n):\n    raw = seed * 251 + 17\n    seed = raw - (raw // 65536) * 65536\n    values = values + [seed]\n\nsort(values, 0, benchmark_n - 1)\nchecksum = 0\nfor i in range(benchmark_n):\n    if i > 0 and values[i] < values[i - 1]:\n        raise RuntimeError(\"Unsorted output\")\n    checksum += values[i] * (i + 1)\n    checksum -= (checksum // 1000003) * 1000003\nbenchmark_result = checksum\nbenchmark_elapsed_ms = (perf_counter_ns() - benchmark_start) / 1e6\nprint(\"RESULT\", benchmark_result)\nprint(\"ELAPSED_MS\", benchmark_elapsed_ms)\n",
      "sha256": "31b9d6c74ce3d3e4ff55b2a81a3d6203eaa44fa24b024394742f777f1e607138",
